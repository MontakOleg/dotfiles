# Homebrew completions must be available before compinit, also in zsh -ic.
typeset -U fpath
[[ -d /opt/homebrew/share/zsh/site-functions ]] && \
  fpath=(/opt/homebrew/share/zsh/site-functions $fpath)

# Keep Oh My Zsh optional; Fish is the primary interactive shell.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git git-extras)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit
fi

alias gl="git pull --rebase"
alias vim=nvim
alias be="bundle exec"
alias ungit="git ls-files -ci --exclude-standard -z | xargs -0 git rm --cached"
alias lz="lazygit"

export FZF_DEFAULT_COMMAND='fd --type f'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d'
# Widgets need a terminal; agents sometimes use zsh -ic with pipes.
if [[ -o zle && -t 0 ]]; then
  if [[ -f "$HOME/.fzf.zsh" ]]; then
    source "$HOME/.fzf.zsh"
  elif command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --zsh)"
  fi
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
